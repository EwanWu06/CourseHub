{
  "name": "course-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-school Canvas dashboard: deadlines, weekly AI study guides, daily/weekly reports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "test": "TZ=America/Los_Angeles COURSEHUB_QUIET=1 COURSEHUB_NO_NOTIFY=1 node --disable-warning=ExperimentalWarning --test --test-concurrency=2 \"test/*.test.ts\"",
    "test:chrome": "TZ=America/Los_Angeles COURSEHUB_QUIET=1 COURSEHUB_NO_NOTIFY=1 node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/chrome/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "dev:mock": "node --disable-warning=ExperimentalWarning mock/dev.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "qa": "COURSEHUB_PORT=4198 node --disable-warning=ExperimentalWarning scripts/qa-server.ts",
    "screenshot": "node --disable-warning=ExperimentalWarning scripts/screenshot.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "ical.js": "^2.2.1",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
